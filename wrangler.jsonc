{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swiss3design",
  "account_id": "b88f99010692662e118a9869f47767e4",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "swiss3design.ch", "custom_domain": true },
    { "pattern": "www.swiss3design.ch", "custom_domain": true }
  ],
  // workers.dev maintenu pendant la transition vers le domaine
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swiss3design-db",
      "database_id": "a87e4231-6f56-4c18-9ead-42bb9a47d5fe",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "swiss3design-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4d8b410c8ea743d281c530570668e837"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "swiss3design"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://swiss3design.ch",
    // Les comptes créés avec ces e-mails reçoivent automatiquement le rôle admin
    "ADMIN_EMAILS": "t@prudhomme.li",
    // À passer sur une adresse @swiss3design.ch une fois le domaine vérifié chez Resend
    "EMAIL_FROM": "Swiss3Design <onboarding@resend.dev>"
  }
}
