{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swiss3design",
  // account_id volontairement omis (dépôt public) : un seul compte Cloudflare
  // est accessible depuis la session `wrangler login`/le token de build, donc
  // wrangler le résout tout seul (CLOUDFLARE_ACCOUNT_ID en variable
  // d'environnement reste possible mais inutile ici).
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "swiss3design.ch", "custom_domain": true },
    { "pattern": "www.swiss3design.ch", "custom_domain": true }
  ],
  // Le domaine est en place : l'URL workers.dev est coupée (contenu dupliqué)
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swiss3design-db",
      "database_id": "a87e4231-6f56-4c18-9ead-42bb9a47d5fe",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "swiss3design-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4d8b410c8ea743d281c530570668e837"
    }
  ],
  // Postgres (Neon) via Hyperdrive — base active (pivot 2026-07-09, voir
  // AGENTS.md). Le binding D1 ci-dessus reste câblé comme filet de secours
  // inactif, les deux bindings coexistent délibérément.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ea1ca31861f64d3e9e1f082ee0e10033"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "swiss3design"
    }
  ],
  "observability": {
    "enabled": true
  },
  // ADMIN_EMAILS n'est PAS ici : dépôt public, posé comme secret Cloudflare
  // (`wrangler secret put ADMIN_EMAILS`) plutôt qu'en var en clair — même
  // interface `env.ADMIN_EMAILS` côté code, voir AGENTS.md.
  "vars": {
    "BETTER_AUTH_URL": "https://swiss3design.ch",
    // Alias Infomaniak : les réponses des clients arrivent dans contact@swiss3design.ch
    "EMAIL_FROM": "Swiss3Design <commandes@swiss3design.ch>",
    // « Payment method configuration » Stripe (dashboard → Paramètres de
    // paiement) appliquée aux PaymentIntents. Id public, pas un secret.
    // Vide ou invalide → repli sur la config par défaut (cf. lib/stripe.ts).
    // ⚠️ Toujours pointer la config DU SITE (« Default » / pmc_1Tgkc…), jamais
    // celle gérée par un service tiers connecté (ex. Samsung Electronics
    // America, pmc_1TopVd…) : ses moyens de paiement ne sont pas contrôlables
    // depuis le dashboard et ne correspondent pas à la boutique.
    "STRIPE_PAYMENT_METHOD_CONFIGURATION": "pmc_1TgkcKK4o7ey3lG5alpRZU3l",
    // Clé publiable Stripe (publique par design) lue à l'exécution : permet
    // à la preview d'utiliser la clé TEST alors que le build embarque la
    // clé de .env.production. Doit correspondre au STRIPE_SECRET_KEY du
    // même environnement (même compte, même mode live/test).
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51TgkbnK4o7ey3lG5X2NE0ujxVeMTP1YdHK6gxgefCazQEeX6m5MMDAWPJKWMndMXrcS6tvxR8oXMJ00AxPqnJARb00q2dn8APu"
  },
  // Environnement de preview : Worker séparé (swiss3design-preview), bindings
  // isolés (D1/R2/KV propres, vides — aucune donnée client), sans route sur le
  // domaine custom (routes/workers_dev sont des clés héritables : on les
  // RÉÉCRIT explicitement ici pour ne jamais hériter des routes prod par
  // accident). Déployé via `wrangler deploy --env preview` (build command
  // « non-production » du dashboard Cloudflare Workers Builds).
  "env": {
    "preview": {
      "name": "swiss3design-preview",
      "workers_dev": true,
      // Une seule URL stable et prévisible (pas une URL aléatoire par version).
      "preview_urls": false,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swiss3design-preview-db",
          "database_id": "f4b2c6c5-0fe8-42a3-9aad-5a7a22378d6d",
          "migrations_dir": "drizzle"
        }
      ],
      // Branche Neon isolée "preview" (child de "production", jamais les
      // vraies données clients — voir stack-pivot-medusa-to-hyperdrive.md) :
      // catalogue produits de démo (6 articles, scripts/seed.sql) réinjecté,
      // toutes les tables PII/secrets (orders, user, session, two_factor,
      // passkey, account, customer_addresses, quotes, reviews, newsletters,
      // notifications, verification) tronquées après clonage.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "4262c933ec8f45259643b190d701e8cd"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "swiss3design-preview-files"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "8893ee22e6cf4ccca1b5c2a5dd23ef86"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "swiss3design-preview"
        }
      ],
      "observability": {
        "enabled": true
      },
      // ADMIN_EMAILS n'est pas ici non plus — même secret Cloudflare que la
      // prod, posé via `wrangler secret put ADMIN_EMAILS --env preview`.
      "vars": {
        // Lu par middleware.ts pour désindexer (X-Robots-Tag) tout l'environnement.
        "APP_ENV": "preview",
        "BETTER_AUTH_URL": "https://swiss3design-preview.thomastp.workers.dev",
        "EMAIL_FROM": "Swiss3Design Preview <commandes@swiss3design.ch>",
        // Vide : la preview (clés Stripe test) garde la config par défaut
        "STRIPE_PAYMENT_METHOD_CONFIGURATION": "",
        // Clé publiable TEST (même compte que la prod) — appairée avec le
        // secret STRIPE_SECRET_KEY (sk_test) posé via wrangler secret put.
        "STRIPE_PUBLISHABLE_KEY": "pk_test_51TgkbnK4o7ey3lG5CAqK0NBqFazy43LthNOQ0IKgmiTwv6ni7Cd4yiuaM6M0gb5XHF3HI4PAlYCFlqFr9BNIMND000iDY9eEiF"
      }
    }
  }
}
