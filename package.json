{
  "name": "swiss3design",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:preview": "bun scripts/test-preview.ts",
    "test:watch": "vitest",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview -- --upstream-protocol https",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply swiss3design-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply swiss3design-db --remote",
    "db:seed:local": "wrangler d1 execute swiss3design-db --local --file=./scripts/seed.sql",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:push:pg": "drizzle-kit push --config=drizzle.config.pg.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/passkey": "^1.7.12",
    "@gsap/react": "2.1.2",
    "@opennextjs/cloudflare": "^1.20.13",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "better-auth": "^1.7.12",
    "d3-contour": "4.0.2",
    "drizzle-orm": "^0.45.4",
    "earcut": "3.2.4",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.21",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.1",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/d3-contour": "3.0.6",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "1.3.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "drizzle-kit": "^0.31.11",
    "occt-import-js": "0.0.23",
    "opentype.js": "2.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@swc/core": "1.16.2"
  }
}
