{
  "name": "swiss3design",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:preview": "bun scripts/test-preview.ts",
    "test:watch": "vitest",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply swiss3design-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply swiss3design-db --remote",
    "db:seed:local": "wrangler d1 execute swiss3design-db --local --file=./scripts/seed.sql",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:push:pg": "drizzle-kit push --config=drizzle.config.pg.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.22",
    "@better-auth/passkey": "^1.7.22",
    "@opennextjs/cloudflare": "^1.20.17",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.3.0",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "pg": "^8.23.1",
    "posthog-js": "^1.448.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.1.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@swc/helpers": "^0.5.24",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@swc/core": "1.16.2"
  }
}
