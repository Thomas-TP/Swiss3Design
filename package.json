{
  "name": "swiss3design",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply swiss3design-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply swiss3design-db --remote",
    "db:seed:local": "wrangler d1 execute swiss3design-db --local --file=./scripts/seed.sql",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:push:pg": "drizzle-kit push --config=drizzle.config.pg.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.2",
    "@opennextjs/cloudflare": "^1.20.4",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@types/three": "^0.185.4",
    "better-auth": "^1.7.2",
    "better-auth-cloudflare": "^0.3.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.35.0",
    "motion": "^12.43.0",
    "next": "16.3.3",
    "next-intl": "^4.14.0",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
