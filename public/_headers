/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Posters SVG (isolignes) : régénérés par scripts/gen-field-posters.ts sous le
# même nom, donc un cache d'une semaine et non immuable.
/posters/*
  Cache-Control: public, max-age=604800

# Glyphes du texte en relief : nom versionné (s3d-relief-v1.json), un changement
# de contenu change le nom, d'où « immutable ».
/studio/glyphs/*
  Cache-Control: public, max-age=31536000, immutable
